# =============================================
# SmartLogistics Environment Variables Template
# =============================================
# Copy this file to .env and fill in your values.
# The app works WITHOUT any of these — it uses mock data.

# ------- Backend (FastAPI) -------
# Port the backend runs on (default: 8000)
PORT=8000

# ------- Firebase Admin SDK (backend) -------
# Path to your Firebase service account JSON key
FIREBASE_CREDENTIALS=./firebase-credentials.json
FIREBASE_PROJECT_ID=your-project-id

# ------- Firebase Client SDK (frontend, optional) -------
# If not set, the frontend skips Firebase initialisation
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------- Map Basemaps (optional) -------
# If not set, standard OpenStreetMap tiles are used without any API key or watermarks.
# To use CARTO Voyager tiles, get a free key from carto.com/basemaps/apikey
VITE_CARTO_API_KEY=

# ------- AI Assistant (optional) -------
# Set one of these to enable a real LLM instead of mock responses.
# Then update backend/algorithms/ai_assistant.py → query_ai() to use it.
GEMINI_API_KEY=
OPENAI_API_KEY=
