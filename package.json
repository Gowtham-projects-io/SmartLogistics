{
  "name": "smart-logistics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"python -m uvicorn main:app --app-dir backend --reload --port 8000\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn main:app --app-dir backend --reload --port 8000",
    "backend": "python -m uvicorn main:app --app-dir backend --reload --port 8000",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "deploy": "gh-pages -d frontend/dist",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "gh-pages": "^6.3.0"
  }
}
